FROM oven/bun:1.3.10-alpine

WORKDIR /app

# Copy private registry config (.npmrc lives at project root)
COPY .npmrc .

# Use package_materialized.json: concrete versions instead of workspace:*/catalog: references
COPY frontend-vite/package_materialized.json package.json

RUN bun install

EXPOSE 5173

# Run bun install on every startup so the named volume stays in sync after image rebuilds,
# then clear stale vite dep-optimizer cache before starting the dev server.
CMD ["sh", "-c", "bun install && rm -rf /app/node_modules/.vite && bun run dev -- --host 0.0.0.0"]

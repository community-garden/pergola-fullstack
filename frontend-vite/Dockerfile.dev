FROM oven/bun:1.3.10-alpine

WORKDIR /app

# Put .npmrc in the home dir so the /app volume mount can't clobber it.
# Bun (like npm) reads ~/.npmrc for registry config.
COPY .npmrc /root/.npmrc

# Store the materialized package.json outside /app so the volume mount can't clobber it.
# workspace:*/catalog: refs are already resolved to concrete versions here.
COPY frontend-vite/package_materialized.json /package_materialized.json

RUN cp /package_materialized.json /app/package.json && bun install

EXPOSE 5173

# At startup: restore the materialized package.json (volume mount overwrites it with the
# host's workspace-ref version), drop the host bun.lock (it has workspace refs too),
# clear stale vite dep-optimizer cache, then start the dev server.
CMD ["sh", "-c", "cp /package_materialized.json /app/package.json && rm -f /app/bun.lock && bun install && rm -rf /app/node_modules/.vite && bun run dev -- --host 0.0.0.0"]

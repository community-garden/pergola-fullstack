# API Configuration
VITE_API_URL=http://localhost:3000/api

# Authentication Configuration
# empty VITE_OIDC_AUTHORITY = login disabled
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/keycloak-connect-graphql
VITE_CLIENT_ID=keycloak-connect-graphql-public
VITE_REDIRECT_URI=http://localhost:5173/
VITE_OAUTH_SCOPE=openid profile email

# Other Configuration
VITE_OPENWEATHER_API_KEY=your_api_key_here
# Leave VITE_OIDC_AUTHORITY empty to run without login (the Login button is greyed out)
# Optional proxy for knowledge-base requests (GBIF); empty = direct requests
# VITE_KB_PROXY_URL=http://localhost:4000

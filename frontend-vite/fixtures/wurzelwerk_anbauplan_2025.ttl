    ww:sowingMethod     ww:Pflanzung ;
    ww:plantingDate     "Mai"@de ;
    ww:harvestStart     "Oktober"@de ;
    ww:harvestEnd       "März (Folgejahr)"@de .

garden:planting-tausendfuessler-kuerbis  a ww:Planting ;

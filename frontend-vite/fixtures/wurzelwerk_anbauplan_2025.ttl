    ww:sowingMethod     ww:Pflanzung ;
    ww:plantingDate     "Mitte Mai"@de ;
    ww:harvestStart     "August"@de ;
    ww:harvestEnd       "Oktober"@de .

garden:planting-tausendfuessler-radieschen  a ww:Planting ;
    ww:hasPlant         garden:plant-radieschen ;
    ww:sowingMethod     ww:Direktsaat ;
    ww:sowingDate       "März"@de ;
    ww:harvestStart     "April"@de ;
    ww:harvestEnd       "Mai"@de .

garden:planting-tausendfuessler-ringelblume  a ww:Planting ;
    ww:hasPlant         garden:plant-ringelblume ;
    ww:sowingMethod     ww:Direktsaat ;
    ww:sowingDate       "April"@de ;
    ww:note             "Begleitpflanze / Mischkultur"@de .


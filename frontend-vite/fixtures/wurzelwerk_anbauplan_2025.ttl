@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix ww:     <https://wurzelwerk.garden/ontology#> .
@prefix garden: <https://wurzelwerk.garden/2025/> .
@prefix dbr:    <http://dbpedia.org/resource/> .
@prefix time:   <http://www.w3.org/2006/time#> .

# =============================================================================
# Ontology definitions
# =============================================================================

ww:Garden          a rdfs:Class ;
    rdfs:label      "Gemeinschaftsgarten"@de , "Community Garden"@en ;
    rdfs:comment    "A community garden with multiple beds."@en .

ww:Bed             a rdfs:Class ;
    rdfs:label      "Beet"@de , "Garden Bed"@en ;
    rdfs:comment    "A distinct planting bed within the garden."@en .

ww:Planting        a rdfs:Class ;
    rdfs:label      "Pflanzung"@de , "Planting"@en ;
    rdfs:comment    "A specific crop planting within a bed for a season."@en .

ww:Plant           a rdfs:Class ;
    rdfs:label      "Pflanze"@de , "Plant"@en .

ww:SowingMethod    a rdfs:Class ;
    rdfs:label      "Aussaatmethode"@de , "Sowing Method"@en .

ww:hasBed          a rdf:Property ;
    rdfs:domain     ww:Garden ;
    rdfs:range      ww:Bed .

ww:hasPlanting     a rdf:Property ;
    rdfs:domain     ww:Bed ;
    rdfs:range      ww:Planting .

ww:hasPlant        a rdf:Property ;
    rdfs:domain     ww:Planting ;
    rdfs:range      ww:Plant .

ww:sowingMethod    a rdf:Property ;
    rdfs:domain     ww:Planting ;
    rdfs:range      ww:SowingMethod ;
    rdfs:comment    "DS = Direktsaat (direct sowing), Pflanzung = transplanting."@en .

ww:sowingDate      a rdf:Property ;
    rdfs:domain     ww:Planting ;
    rdfs:range      xsd:string ;
    rdfs:comment    "When to sow or start the crop."@en .

ww:plantingDate    a rdf:Property ;
    rdfs:domain     ww:Planting ;
    rdfs:range      xsd:string ;
    rdfs:comment    "When to transplant seedlings into the bed."@en .

ww:harvestStart    a rdf:Property ;
    rdfs:domain     ww:Planting ;
    rdfs:range      xsd:string ;
    rdfs:comment    "Beginning of harvest window."@en .

ww:harvestEnd      a rdf:Property ;
    rdfs:domain     ww:Planting ;
    rdfs:range      xsd:string ;
    rdfs:comment    "End of harvest window."@en .

ww:caretaker       a rdf:Property ;
    rdfs:domain     ww:Bed ;
    rdfs:range      xsd:string ;
    rdfs:comment    "Nickname of person responsible for this bed."@en .

ww:bedNickname     a rdf:Property ;
    rdfs:domain     ww:Bed ;
    rdfs:range      xsd:string ;
    rdfs:comment    "Animal nickname for the bed."@en .

ww:plantFamily     a rdf:Property ;
    rdfs:domain     ww:Planting ;
    rdfs:range      xsd:string ;
    rdfs:comment    "Botanical family or combination note (Fam. Kombi)."@en .

ww:note            a rdf:Property ;
    rdfs:domain     rdfs:Resource ;
    rdfs:range      xsd:string .

# -- Sowing method instances ---------------------------------------------------

ww:Direktsaat      a ww:SowingMethod ;
    rdfs:label      "Direktsaat"@de , "Direct Sowing"@en ;
    rdfs:comment    "Seeds are sown directly into the bed."@en .

ww:Pflanzung       a ww:SowingMethod ;
    rdfs:label      "Pflanzung"@de , "Transplanting"@en ;
    rdfs:comment    "Seedlings are pre-grown and transplanted."@en .

ww:Vorkultur       a ww:SowingMethod ;
    rdfs:label      "Vorkultur"@de , "Pre-cultivation"@en ;
    rdfs:comment    "Started indoors before transplanting."@en .

# =============================================================================
# The Garden
# =============================================================================

garden:Wurzelwerk   a ww:Garden ;
    rdfs:label      "Wurzelwerk"@de ;
    schema:name     "Wurzelwerk Gemeinschaftsgarten" ;
    ww:note         "Beet- und Anbauplanung 2025"@de ;
    ww:hasBed       garden:bed-tausendfuessler ,
                    garden:bed-hummel ,
                    garden:bed-igel ,
                    garden:bed-schnecke ,
                    garden:bed-kroete-frosch ,
                    garden:bed-folientunnel ,
                    garden:bed-dachsbeet ,
                    garden:bed-bluehwiese ,
                    garden:bed-salatbeet ,
                    garden:bed-rucola-gemeinschaftsbeet ,
                    garden:bed-regenwurm ,
                    garden:bed-kompost ,
                    garden:bed-kraeuterbeet ,
                    garden:bed-giessland .

# =============================================================================
# Bed: Tausendfüßler (Millipede)
# =============================================================================

garden:bed-tausendfuessler  a ww:Bed ;
    rdfs:label          "Tausendfüßler"@de ;
    ww:bedNickname      "Tausendfüßler" ;
    rdfs:comment        "Large bed in the upper-left area of the garden."@en ;
    ww:hasPlanting      garden:planting-tausendfuessler-kartoffel ,
                        garden:planting-tausendfuessler-knoblauch ,
                        garden:planting-tausendfuessler-buschbohne ,
                        garden:planting-tausendfuessler-palmkohl ,
                        garden:planting-tausendfuessler-kuerbis ,
                        garden:planting-tausendfuessler-radieschen ,
                        garden:planting-tausendfuessler-ringelblume .

garden:planting-tausendfuessler-kartoffel  a ww:Planting ;
    ww:hasPlant         garden:plant-kartoffel ;
    ww:sowingMethod     ww:Direktsaat ;
    ww:plantingDate     "Mitte März"@de ;
    ww:harvestStart     "Juni"@de ;
    ww:harvestEnd       "Oktober"@de ;
    ww:note             "Mehrere Sorten"@de .

garden:planting-tausendfuessler-knoblauch  a ww:Planting ;
    ww:hasPlant         garden:plant-knoblauch ;
    ww:sowingMethod     ww:Direktsaat ;
    ww:sowingDate       "Oktober (Vorjahr)"@de ;
    ww:harvestStart     "Juni"@de ;
    ww:harvestEnd       "Juli"@de .

garden:planting-tausendfuessler-buschbohne  a ww:Planting ;
    ww:hasPlant         garden:plant-buschbohne ;
    ww:sowingMethod     ww:Direktsaat ;
    ww:sowingDate       "Mai"@de ;
    ww:harvestStart     "Juli"@de ;
    ww:harvestEnd       "September"@de .

garden:planting-tausendfuessler-palmkohl  a ww:Planting ;
